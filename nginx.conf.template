server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # Forward API calls to turva-back, like the Vite dev proxy in vite.config.ts
    # BACKEND_URL is filled in at container start: PROD by default (Dockerfile),
    # overridden for local dev in docker-compose.yml
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
    }

    # SPA fallback for react-router
    location / {
        try_files $uri $uri/ /index.html;
    }
}
